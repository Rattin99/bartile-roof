generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TileProfile {
  id               String         @id @default(uuid())
  profile_id       String?        @unique
  name             String
  category         String?
  description      String?
  image_url        String?
  model_asset_path String?
  icon_asset_path  String?
  features         String[]
  sort_order       Int            @default(0)
  is_active        Boolean        @default(true)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  housePreviews    HousePreview[]
}

model TileColor {
  id            String         @id @default(uuid())
  color_id      String?        @unique
  name          String
  hex_code      String
  category      String?
  is_standard   Boolean        @default(true)
  is_active     Boolean        @default(true)
  sort_order    Int            @default(0)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  housePreviews HousePreview[]
}

model TileTexture {
  id                   String         @id @default(uuid())
  texture_id           String?        @unique
  name                 String
  description          String?
  image_url            String?
  map_asset_path       String?
  thumbnail_asset_path String?
  is_premium           Boolean        @default(false)
  note                 String?
  is_active            Boolean        @default(true)
  sort_order           Int            @default(0)
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt
  housePreviews        HousePreview[]
}

model LayoutOption {
  id                   String   @id @default(uuid())
  name                 String
  thumbnail_asset_path String?
  sort_order           Int      @default(0)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}

model HousePreview {
  id         String       @id @default(uuid())
  house_id   String?      @unique
  name       String?
  image_url  String
  tags       String[]
  is_active  Boolean      @default(true)
  sort_order Int          @default(0)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  profile_id String?
  color_id   String?
  texture_id String?
  color      TileColor?   @relation(fields: [color_id], references: [id])
  profile    TileProfile? @relation(fields: [profile_id], references: [id])
  texture    TileTexture? @relation(fields: [texture_id], references: [id])
}

model QuoteRequest {
  id                     String   @id @default(uuid())
  contact_name           String
  contact_email          String
  contact_phone          String?
  project_address        String?
  estimated_squares      Float?
  plan_file_path         String?
  configuration_snapshot Json?
  status                 String   @default("NEW")
  comments               String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
}
